---
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const products = [
    { slug: 'rais-wood-burning-stove', title: 'RAIS Wood-Burning Stove', brand: 'RAIS', type: 'Wood-Burning', installation: 'Freestanding', view: 'Panoramic 360°', description: 'Modern wood-burning stove with panoramic 360° view, combining Scandinavian design with exceptional heating performance.' },
    { slug: 'haas-sohn-gas-fireplace', title: 'HAAS+SOHN Gas Fireplace', brand: 'HAAS+SOHN', type: 'Gas', installation: 'Built-in', view: 'Double-sided', description: 'Premium gas fireplace with realistic flame technology and remote control operation.' },
    { slug: 'element4-bioethanol', title: 'ELEMENT4 Bioethanol Fireplace', brand: 'ELEMENT4', type: 'Bioethanol', installation: 'Built-in', view: 'Single-sided', description: 'Sleek bioethanol fireplace, ventless and eco-friendly, perfect for contemporary interiors.' },
    { slug: 'ruegg-traditional-stove', title: 'RUEGG Traditional Stove', brand: 'RUEGG', type: 'Wood-Burning', installation: 'Freestanding', view: 'Single-sided', description: 'Swiss-made traditional stove with timeless elegance and exceptional build quality.' },
    { slug: 'lacunza-outdoor-fire-pit', title: 'LACUNZA Outdoor Fire Pit', brand: 'LACUNZA', type: 'Outdoor', installation: 'Freestanding', view: 'Panoramic', description: 'Spanish-designed outdoor fire pit for garden and terrace entertainment spaces.' },
    { slug: 'decoflame-electric', title: 'DECOFLAME Electric Fireplace', brand: 'DECOFLAME', type: 'Electric', installation: 'Wall-mounted', view: 'Single-sided', description: 'Contemporary electric fireplace with realistic flame effects and easy installation.' },
    { slug: 'haas-sohn-double-gas', title: 'HAAS+SOHN Double-Sided Gas', brand: 'HAAS+SOHN', type: 'Gas', installation: 'Built-in', view: 'Double-sided', description: 'Double-sided gas fireplace, perfect for room dividers and open-plan spaces.' },
    { slug: 'rais-wall-mounted', title: 'RAIS Wall-Mounted Fireplace', brand: 'RAIS', type: 'Electric', installation: 'Wall-mounted', view: 'Single-sided', description: 'Sleek wall-mounted electric fireplace from the renowned Danish design house.' },
    { slug: 'outdoor-fire-bowl', title: 'Outdoor Fire Bowl', brand: 'BILU ZONGSHI', type: 'Outdoor', installation: 'Freestanding', view: 'Panoramic', description: 'Elegant outdoor fire bowl crafted from weather-resistant materials.' },
    { slug: 'custom-builtin-gas', title: 'Custom Built-in Gas Fireplace', brand: 'BILU ZONGSHI', type: 'Gas', installation: 'Built-in', view: 'Three-sided', description: 'Bespoke three-sided gas fireplace designed for luxury residential interiors.' },
    { slug: 'suspended-bioethanol', title: 'Suspended Bioethanol Fireplace', brand: 'ELEMENT4', type: 'Bioethanol', installation: 'Suspended', view: 'Panoramic', description: 'Stunning suspended bioethanol fireplace that serves as a true statement piece.' },
    { slug: 'ruegg-corner-fireplace', title: 'Ruegg Corner Fireplace', brand: 'RUEGG', type: 'Wood-Burning', installation: 'Built-in', view: 'Corner', description: 'Space-saving corner wood-burning fireplace with signature Swiss craftsmanship.' },
  ];

  return products.map((product) => ({
    params: { slug: product.slug },
    props: product,
  }));
}

const { slug, title, brand, type, installation, view, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  
  <!-- Breadcrumb -->
  <div class="bg-stone-100 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center gap-2 text-sm text-charcoal-500">
        <a href="/" class="hover:text-fire-600">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-fire-600">Products</a>
        <span>/</span>
        <span class="text-charcoal-800 font-medium">{title}</span>
      </div>
    </div>
  </div>

  <!-- Product Detail -->
  <section class="py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Image Gallery -->
        <div>
          <div class="bg-charcoal-100 rounded-2xl aspect-[4/3] flex items-center justify-center mb-4">
            <span class="text-8xl">🔥</span>
          </div>
          <div class="grid grid-cols-4 gap-3">
            {[1, 2, 3, 4].map((i) => (
              <div class="bg-charcoal-100 rounded-xl aspect-square flex items-center justify-center cursor-pointer hover:ring-2 hover:ring-fire-500 transition-all">
                <span class="text-2xl">🔥</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Product Info -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-fire-600 text-white text-xs font-bold px-3 py-1 rounded-full">{brand}</span>
            <span class="bg-charcoal-100 text-charcoal-600 text-xs px-3 py-1 rounded-full">{type}</span>
          </div>

          <h1 class="text-3xl lg:text-4xl font-bold text-charcoal-800 mb-4">{title}</h1>
          <p class="text-lg text-charcoal-600 leading-relaxed mb-8">{description}</p>

          <!-- Specs -->
          <div class="bg-stone-50 rounded-2xl p-6 mb-8">
            <h3 class="font-semibold text-charcoal-800 mb-4">Specifications</h3>
            <div class="space-y-3">
              {[
                { label: 'Brand', value: brand },
                { label: 'Type', value: type },
                { label: 'Installation', value: installation },
                { label: 'View', value: view },
              ].map((spec) => (
                <div class="flex justify-between py-2 border-b border-stone-200 last:border-0">
                  <span class="text-charcoal-500 text-sm">{spec.label}</span>
                  <span class="text-charcoal-800 text-sm font-medium">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA -->
          <div class="space-y-3">
            <a
              href="/contact"
              class="block w-full text-center bg-fire-600 text-white px-8 py-4 rounded-xl text-lg font-semibold hover:bg-fire-700 transition-all shadow-sm"
            >
              Request a Quote
            </a>
            <a
              href="tel:+861234567890"
              class="block w-full text-center border-2 border-charcoal-200 text-charcoal-700 px-8 py-4 rounded-xl text-lg font-semibold hover:border-fire-400 hover:text-fire-600 transition-all"
            >
              Call Us for Inquiry
            </a>
          </div>

          <!-- Share -->
          <div class="flex items-center gap-4 mt-8 pt-8 border-t border-stone-200">
            <span class="text-sm text-charcoal-500">Share:</span>
            {['Facebook', 'Twitter', 'Pinterest', 'Email'].map((s) => (
              <a href="#" class="text-charcoal-400 hover:text-fire-600 transition-colors text-sm font-medium">{s}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- JSON-LD Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": title,
    "description": description,
    "brand": { "@type": "Brand", "name": brand },
    "category": type,
    "url": `https://sfireplace.com/products/${slug}`
  })} />
</BaseLayout>
