---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';
const t = getTranslations('zh');
---

<BaseLayout title="关于我们" description={t.about.subtitle}>

  <section class="relative py-20 lg:py-28 bg-charcoal-900">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, rgba(251, 146, 60, 0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-fire-400 font-semibold text-sm uppercase tracking-wider">{t.about.title}</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mt-4 mb-6">{t.about.title}</h1>
      <p class="text-lg text-charcoal-300 max-w-2xl mx-auto">{t.about.subtitle}</p>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-charcoal-800 mb-6">{t.about.storyTitle}</h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>{t.about.storyP1}</p>
            <p>{t.about.storyP2}</p>
            <p>{t.about.storyP3}</p>
          </div>
        </div>
        <div class="bg-charcoal-100 rounded-2xl aspect-square flex items-center justify-center">
          <span class="text-8xl">🔥</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-charcoal-800 text-center mb-14">{t.about.journeyTitle}</h2>
      <div class="space-y-8">
        {[
          { year: '2008', event: '公司成立，开启壁炉事业' },
          { year: '2012', event: '拓展国际品牌，与欧洲制造商合作' },
          { year: '2015', event: '获得ISO9001认证，取得首批国家专利' },
          { year: '2018', event: '完成100+高端项目，成为设计师首选品牌' },
          { year: '2023', event: '推出壁炉宗师品牌，进军国际市场' },
          { year: '2026', event: '持续创新，拓展全球业务' },
        ].map((item) => (
          <div class="flex gap-6 items-start">
            <div class="flex flex-col items-center">
              <div class="w-4 h-4 rounded-full bg-fire-600 ring-4 ring-fire-100"></div>
              <div class="w-0.5 h-full bg-fire-200 mt-2"></div>
            </div>
            <div class="pb-8">
              <span class="text-fire-600 font-bold text-lg">{item.year}</span>
              <p class="text-charcoal-600 mt-1">{item.event}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-stone-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-charcoal-800 text-center mb-4">{t.about.valuesTitle}</h2>
      <p class="text-charcoal-500 text-center mb-14 max-w-xl mx-auto">{t.about.valuesSubtitle}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { title: '品质至上', desc: '我们绝不妥协品质。每件产品在到达客户手中之前都经过严格检验。', icon: '⭐' },
          { title: '客户为本', desc: '您的满意是我们的首要任务。从选型到安装，我们提供个性化服务。', icon: '❤️' },
          { title: '持续创新', desc: '我们不断探索新的设计、技术和可持续解决方案。', icon: '💡' },
        ].map((v) => (
          <div class="bg-white rounded-2xl p-8 shadow-sm text-center">
            <span class="text-4xl block mb-4">{v.icon}</span>
            <h3 class="text-lg font-semibold text-charcoal-800 mb-3">{v.title}</h3>
            <p class="text-charcoal-500 text-sm">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
