---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" description="Fireplace Master has been supplying premium fireplaces since 2008. Learn about our story, mission, and commitment to quality.">

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 bg-charcoal-900">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, rgba(251, 146, 60, 0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-fire-400 font-semibold text-sm uppercase tracking-wider">About Us</span>
      <h1 class="text-4xl lg:text-5xl font-bold text-white mt-4 mb-6">
        Our Story
      </h1>
      <p class="text-lg text-charcoal-300 max-w-2xl mx-auto">
        For nearly two decades, we have been dedicated to bringing the warmth and beauty of premium fireplaces to homes around the world.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-charcoal-800 mb-6">
            Founded in 2008
          </h2>
          <div class="space-y-4 text-charcoal-600 leading-relaxed">
            <p>
              Fireplace Master (formerly known as Dongri Shenghuo) was established in 2008 with a simple mission: 
              to provide premium quality fireplaces and professional service to customers worldwide.
            </p>
            <p>
              Over the years, we have grown into a comprehensive enterprise integrating design, research & development, 
              production, sales, and service. We have earned ISO9001 quality system certification and obtained numerous 
              national patents and software copyrights.
            </p>
            <p>
              Our team possesses nearly 20 years of experience in customizing personalized, high-quality fireplaces 
              across all categories. We have built an impressive portfolio of projects and cases, becoming the go-to 
              brand for many renowned designers.
            </p>
          </div>
        </div>
        <div class="bg-charcoal-100 rounded-2xl aspect-square flex items-center justify-center">
          <span class="text-8xl">🔥</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-charcoal-800 text-center mb-14">Our Journey</h2>
      <div class="space-y-8">
        {[
          { year: '2008', event: 'Company founded, beginning our fireplace journey' },
          { year: '2012', event: 'Expanded to international brands, partnering with European manufacturers' },
          { year: '2015', event: 'Achieved ISO9001 certification and obtained first national patents' },
          { year: '2018', event: 'Completed 100+ premium projects, became preferred brand for designers' },
          { year: '2023', event: 'Launched Fireplace Master brand for international markets' },
          { year: '2026', event: 'Continuing to innovate and expand our global presence' },
        ].map((item) => (
          <div class="flex gap-6 items-start">
            <div class="flex flex-col items-center">
              <div class="w-4 h-4 rounded-full bg-fire-600 ring-4 ring-fire-100"></div>
              <div class="w-0.5 h-full bg-fire-200 mt-2"></div>
            </div>
            <div class="pb-8">
              <span class="text-fire-600 font-bold text-lg">{item.year}</span>
              <p class="text-charcoal-600 mt-1">{item.event}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-charcoal-800 text-center mb-4">Our Values</h2>
      <p class="text-charcoal-500 text-center mb-14 max-w-xl mx-auto">What drives us every day</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { title: 'Quality First', desc: 'We never compromise on quality. Every product meets rigorous standards before reaching our customers.', icon: '⭐' },
          { title: 'Customer Focus', desc: 'Your satisfaction is our priority. We provide personalized service from selection through installation.', icon: '❤️' },
          { title: 'Innovation', desc: 'We continuously explore new designs, technologies, and sustainable solutions for modern living.', icon: '💡' },
        ].map((v) => (
          <div class="bg-white rounded-2xl p-8 shadow-sm text-center">
            <span class="text-4xl block mb-4">{v.icon}</span>
            <h3 class="text-lg font-semibold text-charcoal-800 mb-3">{v.title}</h3>
            <p class="text-charcoal-500 text-sm">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
