---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ProductCard from '@components/ProductCard.astro';

const featured = [
  { title: 'RAIS Wood-Burning Stove', slug: 'rais-wood-burning-stove', image: '/images/ref_rais_Qtee.jpg', brand: 'RAIS', type: 'wood-burning', featured: true },
  { title: 'ELEMENT4 Bioethanol Fireplace', slug: 'element4-bioethanol', image: '/images/ref_bio_regular.jpg', brand: 'ELEMENT4', type: 'alcohol', featured: true },
  { title: 'HAAS+SOHN Gas Fireplace', slug: 'haas-sohn-gas-fireplace', image: '/images/ref_bio_double.jpg', brand: 'HAAS+SOHN', type: 'gas', featured: true },
  { title: 'LACUNZA Outdoor Fire Pit', slug: 'lacunza-outdoor-fire-pit', image: '/images/ref_lacunza_Altea.jpg', brand: 'LACUNZA', type: 'outdoor', featured: true },
];

const brands = ['RAIS', 'HAAS+SOHN', 'RUEGG', 'LACUNZA', 'ELEMENT4', 'DECOFLAME'];
---

<BaseLayout title="Premium Fireplaces" description="Fireplace Master offers premium wood-burning, gas, alcohol, and electric fireplaces from world-renowned brands.">

  <Hero
    title="Fireplaces that<br/>define your space."
    subtitle="A curated collection of the world's finest wood-burning, gas, bioethanol, and electric fireplaces."
    ctaText="Explore Products"
    ctaLink="/products"
    secondaryText="View Projects"
    secondaryLink="/projects"
  />

  <!-- Featured -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="text-center max-w-[600px] mx-auto mb-16">
        <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] mb-4">Our collection.</h2>
        <p class="text-lg lg:text-xl text-[#86868b] leading-relaxed max-w-2xl mx-auto">Every fireplace tells a story. Discover pieces that bring warmth and character to your home.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {featured.map(p => <ProductCard {...p} />)}
      </div>
      <div class="text-center mt-12">
        <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-[#1d1d1f] text-white hover:bg-black">See all products <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="py-20 lg:py-32 bg-[#fafafa]">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10 text-center">
      <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] mb-3">World-class brands.</h2>
      <p class="text-lg lg:text-xl text-[#86868b] leading-relaxed max-w-2xl mx-auto mb-12">We partner with the most respected fireplace manufacturers globally.</p>
      <div class="flex flex-wrap justify-center items-center gap-8 lg:gap-16">
        {brands.map(b => <span class="text-lg lg:text-xl font-bold tracking-tight text-[#d2d2d7] hover:text-[#86868b] transition-colors">{b}</span>)}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] mb-6">Crafting warmth<br/>since 2008.</h2>
          <p class="text-[#86868b] text-lg leading-relaxed mb-8">Nearly two decades of expertise in designing, supplying, and installing premium fireplaces. Every product is ISO9001 certified and rigorously tested.</p>
          <a href="/about" class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-[#1d1d1f] text-white hover:bg-black">Learn our story <span aria-hidden="true">→</span></a>
        </div>
        <div><img src="/images/ref_bio_panoramic.jpg" alt="Fireplace showcase" loading="lazy" class="rounded-2xl w-full" /></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-32 bg-[#1d1d1f] text-center">
    <div class="max-w-[600px] mx-auto px-6 lg:px-10">
      <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-white mb-4">Ready to get started?</h2>
      <p class="text-lg text-[#86868b] mb-8">Contact us for a free consultation. We'll help you find the perfect fireplace.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-base font-medium bg-white text-[#1d1d1f] hover:bg-gray-100 transition-all">Get your free quote <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
