---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';

const projects = [
  { title: 'Luxury Villa Fireplace Installation', slug: 'luxury-villa', category: 'Residential', description: 'Custom double-sided gas fireplace installation in a luxury villa living room.', image: '' },
  { title: 'Modern Apartment Renovation', slug: 'modern-apartment', category: 'Residential', description: 'Sleek bioethanol fireplace for a contemporary apartment renovation project.', image: '' },
  { title: 'Outdoor Restaurant Terrace', slug: 'outdoor-restaurant', category: 'Commercial', description: 'Multiple outdoor fire pits for a premium restaurant terrace in the city center.', image: '' },
  { title: 'Hotel Lobby Feature', slug: 'hotel-lobby', category: 'Commercial', description: 'Statement suspended fireplace for a 5-star hotel lobby.', image: '' },
  { title: 'Garden Landscape Project', slug: 'garden-landscape', category: 'Landscape', description: 'Custom outdoor fireplace and fire pit combination for a private garden.', image: '' },
  { title: 'Office Lounge Area', slug: 'office-lounge', category: 'Commercial', description: 'Modern gas fireplace creating a warm atmosphere in a corporate lounge.', image: '' },
];
---

<BaseLayout title="Our Projects" description="Browse our portfolio of fireplace installation projects. From luxury villas to commercial spaces, see how we transform spaces with premium fireplaces.">
  
  <section class="py-16 lg:py-20 bg-charcoal-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">Our Projects</h1>
      <p class="text-lg text-charcoal-300 max-w-2xl">
        Explore our portfolio of completed fireplace installations. Each project reflects our commitment to quality and craftsmanship.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
