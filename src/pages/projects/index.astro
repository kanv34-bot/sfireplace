---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';

const projects = [
  { title: 'Luxury Villa Fireplace Installation', slug: 'luxury-villa', category: 'Residential', description: 'Custom double-sided gas fireplace installation in a luxury villa living room.', image: '/images/ref_bio_double.jpg' },
  { title: 'Modern Apartment Renovation', slug: 'modern-apartment', category: 'Residential', description: 'Sleek bioethanol fireplace for a contemporary apartment renovation project.', image: '/images/ref_bio_regular.jpg' },
  { title: 'Outdoor Restaurant Terrace', slug: 'outdoor-restaurant', category: 'Commercial', description: 'Multiple outdoor fire pits for a premium restaurant terrace in the city center.', image: '/images/ref_bio_panoramic.jpg' },
  { title: 'Hotel Lobby Feature', slug: 'hotel-lobby', category: 'Commercial', description: 'Statement suspended fireplace for a 5-star hotel lobby.', image: '/images/ref_bio_suspend.jpg' },
  { title: 'Garden Landscape Project', slug: 'garden-landscape', category: 'Landscape', description: 'Custom outdoor fireplace and fire pit combination for a private garden.', image: '/images/ref_lacunza_Altea.jpg' },
  { title: 'Office Lounge Area', slug: 'office-lounge', category: 'Commercial', description: 'Modern gas fireplace creating a warm atmosphere in a corporate lounge.', image: '/images/ref_rais_Qtee.jpg' },
];
---

<BaseLayout title="Our Projects" description="Browse our portfolio of fireplace installation projects.">
  <section class="py-16 lg:py-20 bg-[#f5f5f7]">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] mb-4">Our Projects</h1>
      <p class="text-lg text-[#86868b] max-w-2xl">Explore our portfolio of completed fireplace installations.</p>
    </div>
  </section>
  <section class="py-12 lg:py-20">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
