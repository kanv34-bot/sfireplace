---
import { getTranslations, nonEnglishLocales, isRtl } from '../../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ProductCard from '@components/ProductCard.astro';

export async function getStaticPaths() {
  return nonEnglishLocales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const rtl = isRtl(locale);

const featuredProducts = [
  { title: { en:'RAIS Wood-Burning Stove', zh:'RAIS 燃木壁炉', fr:'Poêle à Bois RAIS', es:'Estufa de Leña RAIS', de:'RAIS Holzofen', it:'Stufa a Legna RAIS', ru:'Дровяная печь RAIS', ar:'موقد حطب RAIS' }, slug: 'rais-wood-burning-stove', image: '/images/product-rais.jpg', brand: 'RAIS', type: 'wood-burning', description: { en:'Modern wood-burning stove with panoramic view.', zh:'北欧设计的现代燃木壁炉。', fr:'Poêle à bois moderne avec vue panoramique.', es:'Estufa de leña moderna con vista panorámica.', de:'Moderner Holzofen mit Panoramablick.', it:'Stufa a legna moderna con vista panoramica.', ru:'Современная дровяная печь с панорамным видом.', ar:'موقد حطب حديث مع إطلالة بانورامية.' }, featured: true },
  { title: { en:'ELEMENT4 Bioethanol Fireplace', zh:'ELEMENT4 酒精壁炉', fr:'Cheminée Bioéthanol ELEMENT4', es:'Chimenea de Bioetanol ELEMENT4', de:'ELEMENT4 Bioethanol-Kamin', it:'Caminetto Bioetanolo ELEMENT4', ru:'Биоэтаноловый камин ELEMENT4', ar:'مدفأة إيثانول حيوي ELEMENT4' }, slug: 'element4-bioethanol', image: '/images/product-bioethanol.jpg', brand: 'ELEMENT4', type: 'alcohol', description: { en:'Ventless eco-friendly bioethanol fireplace.', zh:'无需烟道的环保酒精壁炉。', fr:'Cheminée bioéthanol écologique sans conduit.', es:'Chimenea de bioetanol ecológica sin chimenea.', de:'Ventilationsloser, umweltfreundlicher Bioethanol-Kamin.', it:'Caminetto bioetanolo ecologico senza canna fumaria.', ru:'Экологичный биоэтаноловый камин без дымохода.', ar:'مدفأة إيثانول حيوي صديقة للبيئة بدون مدخنة.' }, featured: true },
  { title: { en:'HAAS+SOHN Gas Fireplace', zh:'HAAS+SOHN 燃气壁炉', fr:'Cheminée à Gaz HAAS+SOHN', es:'Chimenea de Gas HAAS+SOHN', de:'HAAS+SOHN Gaskamin', it:'Caminetto a Gas HAAS+SOHN', ru:'Газовый камин HAAS+SOHN', ar:'مدفأة غاز HAAS+SOHN' }, slug: 'haas-sohn-gas-fireplace', image: '/images/product-gas.jpg', brand: 'HAAS+SOHN', type: 'gas', description: { en:'Premium gas fireplace with realistic flame.', zh:'高端燃气壁炉，逼真火焰技术。', fr:'Cheminée à gaz premium avec flamme réaliste.', es:'Chimenea de gas premium con llama realista.', de:'Premium-Gaskamin mit realistischer Flamme.', it:'Caminetto a gas premium con fiamma realistica.', ru:'Премиальный газовый камин с реалистичным пламенем.', ar:'مدفأة غاز ممتازة مع لهب واقعي.' }, featured: true },
  { title: { en:'Outdoor Fire Pit', zh:'户外火盆', fr:'Foyer Extérieur', es:'Fogata Exterior', de:'Outdoor-Feuerstelle', it:'Braciere da Esterno', ru:'Уличный очаг', ar:'حفرة نار خارجية' }, slug: 'outdoor-fire-bowl', image: '/images/product-outdoor.jpg', brand: 'BILU ZONGSHI', type: 'outdoor', description: { en:'Elegant outdoor fire pit for gardens.', zh:'优雅的户外火盆，适合花园和露台。', fr:'Foyer extérieur élégant pour jardins.', es:'Elegante fogata exterior para jardines.', de:'Eleganter Outdoor-Feuerstelle für Gärten.', it:'Elegante braciere da esterno per giardini.', ru:'Элегантный уличный очаг для сада.', ar:'حفرة نار خارجية أنيقة للحدائق.' }, featured: true },
];

const getTitle = (obj: any) => obj[locale] || obj.en;
const getDesc = (obj: any) => obj[locale] || obj.en;
const featuredLocalized = featuredProducts.map(p => ({ ...p, title: getTitle(p.title), description: getDesc(p.description) }));
---

<BaseLayout title={t.siteTitle} description={t.siteDescription} lang={locale} dir={rtl ? 'rtl' : 'ltr'}>

  <Hero title={t.hero.title} subtitle={t.hero.subtitle} ctaText={t.hero.cta} ctaLink={`/${locale}/products`} secondaryText={t.hero.secondary} secondaryLink={`/${locale}/projects`} />

  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-fire-600 font-semibold text-sm uppercase tracking-wider">{t.products.featured}</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-charcoal-800 mt-3 mb-4">{t.home.featuredTitle}</h2>
        <p class="text-charcoal-500 text-lg">{t.home.featuredSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {featuredLocalized.map((product) => <ProductCard {...product} locale={locale} />)}
      </div>
      <div class="text-center mt-12">
        <a href={`/${locale}/products`} class="inline-flex items-center gap-2 bg-fire-600 text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-fire-700 transition-all shadow-sm">
          {t.home.viewAll} <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-fire-600 font-semibold text-sm uppercase tracking-wider">{t.products.type}</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-charcoal-800 mt-3 mb-4">{t.home.categoriesTitle}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {Object.entries(t.categories).slice(0,6).map(([key, name]) => (
          <a href={`/${locale}/products?type=${key}`} class="group relative rounded-2xl overflow-hidden bg-gradient-to-br from-charcoal-800 to-charcoal-700 p-6 min-h-[200px] flex flex-col justify-end hover:scale-[1.02] transition-transform">
            <h3 class="text-xl font-bold text-white mb-1">{name}</h3>
            <span class="absolute top-4 right-4 text-white/30 group-hover:text-white/60"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-charcoal-800 mb-4">{t.home.brandsTitle}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 mt-10">
        {t.brands.map((brand: string) => (
          <div class="bg-white rounded-xl p-6 flex items-center justify-center min-h-[80px] shadow-sm"><span class="text-lg font-bold text-charcoal-400">{brand}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-charcoal-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-3xl lg:text-4xl font-bold mt-3 mb-4">{t.home.whyTitle}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        {t.whyUs.map((item: any) => (
          <div class="text-center"><span class="text-4xl block mb-4">{item.icon}</span><h3 class="text-lg font-semibold mb-2">{item.title}</h3><p class="text-charcoal-400 text-sm leading-relaxed">{item.desc}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-r from-fire-700 to-fire-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">{t.home.ctaTitle}</h2>
      <a href={`/${locale}/contact`} class="inline-flex items-center gap-2 bg-white text-fire-700 px-8 py-3.5 rounded-xl text-lg font-semibold hover:bg-fire-50 transition-all shadow-lg">{t.home.ctaButton}</a>
    </div>
  </section>
</BaseLayout>
