---
import { getTranslations, nonEnglishLocales, isRtl } from '../../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ProductCard from '@components/ProductCard.astro';

export async function getStaticPaths() {
  return nonEnglishLocales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const rtl = isRtl(locale);

const featured = [
  { title: { en:'RAIS Wood-Burning Stove', zh:'RAIS 燃木壁炉', fr:'Poêle à Bois RAIS', es:'Estufa de Leña RAIS', de:'RAIS Holzofen', it:'Stufa a Legna RAIS', ru:'Дровяная печь RAIS', ar:'موقد حطب RAIS' }, slug: 'rais-wood-burning-stove', image: '/images/ref_rais_Qtee.jpg', brand: 'RAIS', type: 'wood-burning', featured: true },
  { title: { en:'ELEMENT4 Bioethanol', zh:'ELEMENT4 酒精壁炉', fr:'Bioéthanol ELEMENT4', es:'Bioetanol ELEMENT4', de:'ELEMENT4 Bioethanol', it:'Bioetanolo ELEMENT4', ru:'Биоэтанол ELEMENT4', ar:'إيثانول حيوي ELEMENT4' }, slug: 'element4-bioethanol', image: '/images/ref_bio_regular.jpg', brand: 'ELEMENT4', type: 'alcohol', featured: true },
  { title: { en:'HAAS+SOHN Gas Fireplace', zh:'HAAS+SOHN 燃气壁炉', fr:'Cheminée à Gaz HAAS+SOHN', es:'Chimenea de Gas HAAS+SOHN', de:'HAAS+SOHN Gaskamin', it:'Caminetto a Gas HAAS+SOHN', ru:'Газовый камин HAAS+SOHN', ar:'مدفأة غاز HAAS+SOHN' }, slug: 'haas-sohn-gas-fireplace', image: '/images/ref_bio_double.jpg', brand: 'HAAS+SOHN', type: 'gas', featured: true },
  { title: { en:'LACUNZA Outdoor Fire Pit', zh:'LACUNZA 户外火盆', fr:'Foyer LACUNZA', es:'Fogata LACUNZA', de:'LACUNZA Feuerstelle', it:'Braciere LACUNZA', ru:'Очаг LACUNZA', ar:'حفرة نار LACUNZA' }, slug: 'lacunza-outdoor-fire-pit', image: '/images/ref_lacunza_Altea.jpg', brand: 'LACUNZA', type: 'outdoor', featured: true },
];

const getTitle = (o: any) => o[locale] || o.en;
const brands = ['RAIS', 'HAAS+SOHN', 'RUEGG', 'LACUNZA', 'ELEMENT4', 'DECOFLAME'];
const prefix = `/${locale}`;
---

<BaseLayout title={t.siteTitle} description={t.siteDescription} lang={locale} dir={rtl ? 'rtl' : 'ltr'}>

  <Hero
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    ctaText={t.hero.cta}
    ctaLink="/products"
    secondaryText={t.hero.secondary}
    secondaryLink="/projects"
    locale={locale}
  />

  <section class="py-20 lg:py-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="text-center max-w-[600px] mx-auto mb-16">
        <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] mb-4">{t.home.featuredTitle}</h2>
        <p class="text-lg lg:text-xl text-[#86868b] leading-relaxed max-w-2xl mx-auto mx-auto">{t.home.featuredSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {featured.map(p => <ProductCard title={getTitle(p.title)} slug={p.slug} image={p.image} brand={p.brand} type={p.type} featured={p.featured} locale={locale} />)}
      </div>
      <div class="text-center mt-12">
        <a href={`${prefix}/products`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 bg-[#1d1d1f] text-white hover:bg-black">{t.home.viewAll} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-32 bg-[#fafafa]">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10 text-center">
      <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] mb-3">{t.home.brandsTitle}</h2>
      <p class="text-lg lg:text-xl text-[#86868b] leading-relaxed max-w-2xl mx-auto mx-auto mb-12">{t.products.subtitle}</p>
      <div class="flex flex-wrap justify-center gap-8 lg:gap-16">
        {brands.map(b => <span class="text-lg lg:text-xl font-bold tracking-tight text-[#d2d2d7]">{b}</span>)}
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-32 bg-[#1d1d1f] text-center">
    <div class="max-w-[600px] mx-auto px-6 lg:px-10">
      <h2 class="text-3xl lg:text-5xl font-bold tracking-tight text-white mb-4">{t.home.ctaTitle}</h2>
      <a href={`${prefix}/contact`} class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-base font-medium bg-white text-[#1d1d1f] hover:bg-gray-100 transition-all mt-6">
        {t.home.ctaButton} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
