---
import { getTranslations, nonEnglishLocales, isRtl } from '../../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return nonEnglishLocales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const rtl = isRtl(locale);
---

<BaseLayout title={t.about.title} description={t.about.subtitle} lang={locale} dir={rtl ? 'rtl' : 'ltr'}>
  <section class="py-20 bg-charcoal-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">{t.about.title}</h1>
      <p class="text-lg text-charcoal-300">{t.about.subtitle}</p>
    </div>
  </section>
  <section class="py-20"><div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-charcoal-800 mb-6">{t.about.storyTitle}</h2>
    <p class="text-charcoal-600 leading-relaxed">{t.about.subtitle}</p>
  </div></section>
</BaseLayout>
