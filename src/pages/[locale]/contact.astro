---
import { getTranslations, nonEnglishLocales, isRtl } from '../../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return nonEnglishLocales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const rtl = isRtl(locale);

const interestOptions = [
  { en:'Wood-Burning Fireplace', zh:'燃木壁炉', fr:'Cheminée à Bois', es:'Chimenea de Leña', de:'Holzkamin', it:'Caminetto a Legna', ru:'Дровяной камин', ar:'مدفأة حطب' },
  { en:'Gas Fireplace', zh:'燃气壁炉', fr:'Cheminée à Gaz', es:'Chimenea de Gas', de:'Gaskamin', it:'Caminetto a Gas', ru:'Газовый камин', ar:'مدفأة غاز' },
  { en:'Electric Fireplace', zh:'电子壁炉', fr:'Cheminée Électrique', es:'Chimenea Eléctrica', de:'Elektrokamin', it:'Caminetto Elettrico', ru:'Электрический камин', ar:'مدفأة كهربائية' },
];
---

<BaseLayout title={t.contact.title} description={t.contact.subtitle} lang={locale} dir={rtl ? 'rtl' : 'ltr'}>
  <section class="py-16 bg-charcoal-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white mb-4">{t.contact.title}</h1>
      <p class="text-lg text-charcoal-300">{t.contact.subtitle}</p>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-sm p-8">
        <h2 class="text-2xl font-bold mb-6">{t.contact.formTitle}</h2>
        <form name="contact" netlify class="space-y-5">
          <input type="text" name="name" placeholder={t.contact.name} class="w-full px-4 py-3 rounded-xl border border-stone-300" />
          <input type="email" name="email" placeholder={t.contact.email} class="w-full px-4 py-3 rounded-xl border border-stone-300" />
          <textarea name="message" rows="4" placeholder={t.contact.message} class="w-full px-4 py-3 rounded-xl border border-stone-300"></textarea>
          <button type="submit" class="w-full bg-fire-600 text-white py-3.5 rounded-xl font-semibold hover:bg-fire-700">{t.contact.send}</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
