---
import { getTranslations, nonEnglishLocales, isRtl } from '../../../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return nonEnglishLocales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const rtl = isRtl(locale);

const posts = [
  { slug: 'choose-perfect-fireplace', title: { en:'How to Choose the Perfect Fireplace', zh:'如何选择完美壁炉', fr:'Comment Choisir la Cheminée Parfaite', es:'Cómo Elegir la Chimenea Perfecta', de:'Den Perfekten Kamin Wählen', it:'Come Scegliere il Caminetto Perfetto', ru:'Как выбрать идеальный камин', ar:'كيف تختار المدفأة المثالية' }, date: '2026-04-28', category: 'Guide', excerpt: { en:'A comprehensive guide to selecting the right fireplace.', zh:'选择适合壁炉的全面指南。', fr:'Guide complet pour choisir la bonne cheminée.', es:'Guía completa para elegir la chimenea adecuada.', de:'Umfassender Leitfaden zur Auswahl des richtigen Kamins.', it:'Guida completa per scegliere il caminetto giusto.', ru:'Подробное руководство по выбору камина.', ar:'دليل شامل لاختيار المدفأة المناسبة.' } },
  { slug: 'wood-vs-gas-fireplaces', title: { en:'Wood-Burning vs Gas Fireplaces', zh:'燃木 vs 燃气壁炉', fr:'Cheminées à Bois vs Gaz', es:'Chimeneas de Leña vs Gas', de:'Holz- vs Gaskamine', it:'Caminetti a Legna vs Gas', ru:'Дровяные vs Газовые камины', ar:'مواقد الحطب مقابل الغاز' }, date: '2026-04-20', category: 'Comparison', excerpt: { en:'Compare wood-burning and gas fireplaces.', zh:'比较燃木和燃气壁炉的优缺点。', fr:'Comparez les cheminées à bois et à gaz.', es:'Compare chimeneas de leña y gas.', de:'Vergleich von Holz- und Gaskaminen.', it:'Confronto tra caminetti a legna e gas.', ru:'Сравнение дровяных и газовых каминов.', ar:'مقارنة بين مواقد الحطب والغاز.' } },
];

const getTitle = (obj: any) => obj[locale] || obj.en;
const getExcerpt = (obj: any) => obj[locale] || obj.en;
const localizedPosts = posts.map(p => ({ ...p, title: getTitle(p.title), excerpt: getExcerpt(p.excerpt) }));
---

<BaseLayout title={t.blog.title} description={t.blog.subtitle} lang={locale} dir={rtl ? 'rtl' : 'ltr'}>
  <section class="py-16 bg-charcoal-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white mb-4">{t.blog.title}</h1>
      <p class="text-lg text-charcoal-300">{t.blog.subtitle}</p>
    </div>
  </section>
  <section class="py-12"><div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    {localizedPosts.map(post => (
      <a href={`/${locale}/blog/${post.slug}`} class="block bg-white rounded-2xl p-6 mb-6 shadow-sm hover:shadow-md transition-all group">
        <h2 class="text-xl font-bold text-charcoal-800 group-hover:text-fire-600 mb-3">{post.title}</h2>
        <p class="text-charcoal-500">{post.excerpt}</p>
        <span class="inline-flex items-center gap-1 text-sm font-medium text-fire-600 mt-3">{t.blog.readMore} &rarr;</span>
      </a>
    ))}
  </div></section>
</BaseLayout>
