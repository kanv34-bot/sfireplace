---
import { getTranslations, nonEnglishLocales, isRtl } from '../../../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductCard from '@components/ProductCard.astro';
import ProductFilter from '@components/ProductFilter.astro';

export async function getStaticPaths() {
  return nonEnglishLocales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getTranslations(locale);
const rtl = isRtl(locale);

const brands = ['RAIS', 'HAAS+SOHN', 'RUEGG', 'LACUNZA', 'ELEMENT4', 'DECOFLAME', 'BILU ZONGSHI'];
const types = ['wood-burning', 'gas', 'alcohol', 'electric', 'outdoor', 'custom', 'accessories'];
const installations = ['built-in', 'freestanding', 'wall-mounted', 'suspended'];

const url = Astro.url;
const currentBrand = url.searchParams.get('brand') || undefined;
const currentType = url.searchParams.get('type') || undefined;
const currentInstallation = url.searchParams.get('installation') || undefined;

const allProducts = [
  { title: { en:'RAIS Wood-Burning Stove', zh:'RAIS 燃木壁炉', fr:'Poêle à Bois RAIS', es:'Estufa de Leña RAIS', de:'RAIS Holzofen', it:'Stufa a Legna RAIS', ru:'Дровяная печь RAIS', ar:'موقد حطب RAIS' }, slug: 'rais-wood-burning-stove', image: '/images/ref_rais_Qtee.jpg', brand: 'RAIS', type: 'wood-burning', installation: 'freestanding', view: 'panoramic' },
  { title: { en:'HAAS+SOHN Gas Fireplace', zh:'HAAS+SOHN 燃气壁炉', fr:'Cheminée à Gaz HAAS+SOHN', es:'Chimenea de Gas HAAS+SOHN', de:'HAAS+SOHN Gaskamin', it:'Caminetto a Gas HAAS+SOHN', ru:'Газовый камин HAAS+SOHN', ar:'مدفأة غاز HAAS+SOHN' }, slug: 'haas-sohn-gas-fireplace', image: '/images/ref_bio_double.jpg', brand: 'HAAS+SOHN', type: 'gas', installation: 'built-in', view: 'double-sided' },
  { title: { en:'ELEMENT4 Bioethanol', zh:'ELEMENT4 酒精壁炉', fr:'Bioéthanol ELEMENT4', es:'Bioetanol ELEMENT4', de:'ELEMENT4 Bioethanol', it:'Bioetanolo ELEMENT4', ru:'Биоэтанол ELEMENT4', ar:'إيثانول حيوي ELEMENT4' }, slug: 'element4-bioethanol', image: '/images/ref_bio_regular.jpg', brand: 'ELEMENT4', type: 'alcohol', installation: 'built-in', view: 'single-sided' },
  { title: { en:'RUEGG Traditional Stove', zh:'RUEGG 传统壁炉', fr:'Poêle Traditionnel RUEGG', es:'Estufa Tradicional RUEGG', de:'RUEGG Traditioneller Ofen', it:'Stufa Tradizionale RUEGG', ru:'Традиционная печь RUEGG', ar:'موقد تقليدي RUEGG' }, slug: 'ruegg-traditional-stove', brand: 'RUEGG', type: 'wood-burning', installation: 'freestanding', view: 'single-sided' },
  { title: { en:'LACUNZA Outdoor Fire Pit', zh:'LACUNZA 户外火盆', fr:'Foyer Extérieur LACUNZA', es:'Fogata Exterior LACUNZA', de:'LACUNZA Outdoor-Feuerstelle', it:'Braciere da Esterno LACUNZA', ru:'Уличный очаг LACUNZA', ar:'حفرة نار خارجية LACUNZA' }, slug: 'lacunza-outdoor-fire-pit', image: '/images/ref_lacunza_Altea.jpg', brand: 'LACUNZA', type: 'outdoor', installation: 'freestanding', view: 'panoramic' },
  { title: { en:'DECOFLAME Electric', zh:'DECOFLAME 电子壁炉', fr:'Électrique DECOFLAME', es:'Eléctrica DECOFLAME', de:'DECOFLAME Elektro', it:'Elettrico DECOFLAME', ru:'Электрический DECOFLAME', ar:'كهربائي DECOFLAME' }, slug: 'decoflame-electric', brand: 'DECOFLAME', type: 'electric', installation: 'wall-mounted', view: 'single-sided' },
  { title: { en:'Outdoor Fire Bowl', zh:'户外火盆', fr:'Bol de Feu Extérieur', es:'Cuenco de Fuego Exterior', de:'Outdoor-Feuerschale', it:'Braciere da Esterno', ru:'Уличная чаша для огня', ar:'وعاء نار خارجي' }, slug: 'outdoor-fire-bowl', image: '/images/ref_bio_panoramic.jpg', brand: 'BILU ZONGSHI', type: 'outdoor', installation: 'freestanding', view: 'panoramic' },
  { title: { en:'Custom Built-in Gas', zh:'定制嵌入式燃气壁炉', fr:'Gaz Encastré sur Mesure', es:'Gas Empotrado Personalizado', de:'Maßgeschneiderter Gaskamin', it:'Gas su Misura da Incasso', ru:'Встроенный газовый камин', ar:'غاز مدمج مخصص' }, slug: 'custom-builtin-gas', brand: 'BILU ZONGSHI', type: 'gas', installation: 'built-in', view: 'three-sided' },
];

const getTitle = (obj: any) => obj[locale] || obj.en;
const localizedProducts = allProducts.map(p => ({ ...p, title: getTitle(p.title) }));

let filtered = localizedProducts;
if (currentBrand) filtered = filtered.filter(p => p.brand.toLowerCase() === currentBrand.toLowerCase());
if (currentType) filtered = filtered.filter(p => p.type === currentType);
if (currentInstallation) filtered = filtered.filter(p => p.installation === currentInstallation);
---

<BaseLayout title={t.products.title} description={t.products.subtitle} lang={locale} dir={rtl ? 'rtl' : 'ltr'}>
  <section class="py-16 bg-charcoal-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white mb-4">{t.products.title}</h1>
      <p class="text-lg text-charcoal-300">{t.products.subtitle}</p>
    </div>
  </section>
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-4 lg:gap-8">
        <div class="lg:col-span-1 mb-8 lg:mb-0">
          <ProductFilter brands={brands} types={types} installations={installations} currentFilters={{ brand: currentBrand, type: currentType, installation: currentInstallation }} locale={locale} />
        </div>
        <div class="lg:col-span-3">
          <div class="mb-6 text-sm text-charcoal-500">
            {t.products.showing} <span class="font-semibold">{filtered.length}</span> {t.products.count}
            {(currentBrand || currentType || currentInstallation) && (<a href={`/${locale}/products`} class="ml-3 text-fire-600 underline">{t.products.clearFilters}</a>)}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {filtered.map((product) => <ProductCard title={product.title} slug={product.slug} image={product.image} brand={product.brand} type={product.type} locale={locale} />)}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
