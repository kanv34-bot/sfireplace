---
import BaseLayout from '@layouts/BaseLayout.astro';

const posts = [
  { title: 'How to Choose the Perfect Fireplace for Your Home', slug: 'choose-perfect-fireplace', date: '2026-04-28', category: 'Guide', excerpt: 'A comprehensive guide to selecting the right fireplace type for your space, heating needs, and aesthetic preferences.' },
  { title: 'Wood-Burning vs Gas Fireplaces: Pros and Cons', slug: 'wood-vs-gas-fireplaces', date: '2026-04-20', category: 'Comparison', excerpt: 'Compare wood-burning and gas fireplaces to determine which option best suits your lifestyle and home.' },
  { title: 'The Rise of Bioethanol Fireplaces in Modern Design', slug: 'bioethanol-modern-design', date: '2026-04-15', category: 'Trends', excerpt: 'Discover why bioethanol fireplaces are becoming the go-to choice for contemporary interior designers.' },
  { title: 'Outdoor Fire Pit Ideas for Your Garden', slug: 'outdoor-fire-pit-ideas', date: '2026-04-08', category: 'Inspiration', excerpt: 'Transform your outdoor space with these creative fire pit designs and landscaping ideas.' },
  { title: 'Fireplace Maintenance Tips for Every Season', slug: 'fireplace-maintenance-tips', date: '2026-03-28', category: 'Guide', excerpt: 'Keep your fireplace in top condition year-round with these essential maintenance tips.' },
  { title: 'Electric Fireplaces: A Modern Heating Solution', slug: 'electric-fireplace-guide', date: '2026-03-20', category: 'Guide', excerpt: 'Everything you need to know about electric fireplaces, from installation to operation and design options.' },
];
---

<BaseLayout title="Blog" description="Fireplace tips, guides, and inspiration. Learn about different fireplace types, installation advice, maintenance tips, and design ideas.">
  
  <section class="py-16 lg:py-20 bg-charcoal-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">Blog</h1>
      <p class="text-lg text-charcoal-300 max-w-2xl">
        Tips, guides, and inspiration for everything fireplace-related. Stay informed with the latest trends and expert advice.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="block bg-white rounded-2xl p-6 lg:p-8 shadow-sm hover:shadow-md transition-all group"
          >
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="text-xs font-semibold text-fire-600 bg-fire-50 px-2.5 py-1 rounded-full">{post.category}</span>
              <span class="text-xs text-charcoal-400">{post.date}</span>
            </div>
            <h2 class="text-xl lg:text-2xl font-bold text-charcoal-800 group-hover:text-fire-600 transition-colors mb-3">
              {post.title}
            </h2>
            <p class="text-charcoal-500 leading-relaxed">{post.excerpt}</p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-fire-600 mt-4 group-hover:gap-2 transition-all">
              Read More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
