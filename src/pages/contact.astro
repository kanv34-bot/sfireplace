---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us" description="Get in touch with Fireplace Master. Request a quote, ask a question, or schedule a consultation. We are here to help you find the perfect fireplace.">

  <!-- Hero -->
  <section class="py-16 lg:py-20 bg-charcoal-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">Contact Us</h1>
      <p class="text-lg text-charcoal-300 max-w-2xl">
        Ready to start your fireplace journey? Get in touch with us for a free consultation and quote.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl shadow-sm p-8">
            <h2 class="text-2xl font-bold text-charcoal-800 mb-6">Send Us a Message</h2>
            <form name="contact" netlify class="space-y-5" action="/thank-you" method="POST">
              <input type="hidden" name="form-name" value="contact" />
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-charcoal-700 mb-1.5">Full Name *</label>
                  <input type="text" id="name" name="name" required
                    class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-fire-500 focus:ring-2 focus:ring-fire-500/20 outline-none transition-all text-sm" />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-charcoal-700 mb-1.5">Email *</label>
                  <input type="email" id="email" name="email" required
                    class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-fire-500 focus:ring-2 focus:ring-fire-500/20 outline-none transition-all text-sm" />
                </div>
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-charcoal-700 mb-1.5">Phone Number</label>
                <input type="tel" id="phone" name="phone"
                  class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-fire-500 focus:ring-2 focus:ring-fire-500/20 outline-none transition-all text-sm" />
              </div>

              <div>
                <label for="interest" class="block text-sm font-medium text-charcoal-700 mb-1.5">I'm interested in *</label>
                <select id="interest" name="interest" required
                  class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-fire-500 focus:ring-2 focus:ring-fire-500/20 outline-none transition-all text-sm bg-white">
                  <option value="">Select a product type</option>
                  <option value="Wood-Burning Fireplace">Wood-Burning Fireplace</option>
                  <option value="Gas Fireplace">Gas Fireplace</option>
                  <option value="Alcohol/Bioethanol Fireplace">Alcohol/Bioethanol Fireplace</option>
                  <option value="Electric Fireplace">Electric Fireplace</option>
                  <option value="Outdoor Fire Pit">Outdoor Fire Pit</option>
                  <option value="Custom Fireplace">Custom Fireplace</option>
                  <option value="Accessories">Accessories</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-charcoal-700 mb-1.5">Message *</label>
                <textarea id="message" name="message" rows="5" required
                  class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-fire-500 focus:ring-2 focus:ring-fire-500/20 outline-none transition-all text-sm resize-none"
                  placeholder="Tell us about your project, space, and requirements..."></textarea>
              </div>

              <button type="submit"
                class="w-full bg-fire-600 text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-fire-700 transition-all shadow-sm">
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="space-y-6">
          {[
            { icon: '📧', title: 'Email', content: 'info@sfireplace.com', href: 'mailto:info@sfireplace.com' },
            { icon: '📞', title: 'Phone', content: '+86 (10) 1234-5678', href: 'tel:+861012345678' },
            { icon: '📍', title: 'Address', content: 'Beijing, China', href: null },
            { icon: '🕐', title: 'Business Hours', content: 'Mon-Fri: 9:00-18:00', href: null },
          ].map((info) => (
            <div class="bg-white rounded-2xl p-6 shadow-sm">
              <span class="text-2xl block mb-2">{info.icon}</span>
              <h3 class="font-semibold text-charcoal-800 mb-1">{info.title}</h3>
              {info.href ? (
                <a href={info.href} class="text-fire-600 hover:text-fire-700 text-sm">{info.content}</a>
              ) : (
                <p class="text-charcoal-600 text-sm">{info.content}</p>
              )}
            </div>
          ))}

          <!-- Social -->
          <div class="bg-white rounded-2xl p-6 shadow-sm">
            <h3 class="font-semibold text-charcoal-800 mb-4">Follow Us</h3>
            <div class="flex gap-3">
              {['Facebook', 'Instagram', 'Pinterest', 'YouTube'].map((s) => (
                <a href="#" class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center text-charcoal-500 hover:bg-fire-600 hover:text-white transition-all text-xs font-medium">
                  {s[0]}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
