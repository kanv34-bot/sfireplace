---
import { getTranslations } from '../i18n';

export interface Props {
  brands: string[];
  types: string[];
  installations: string[];
  currentFilters: { brand?: string; type?: string; installation?: string; view?: string; };
  locale?: string;
}

const { brands, types, installations, currentFilters, locale = 'en' } = Astro.props;
const t = getTranslations(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;

function filterUrl(key: string, value: string | null): string {
  const params = new URLSearchParams();
  Object.entries(currentFilters).forEach(([k, v]) => { if (k !== key && v) params.set(k, v); });
  if (value) params.set(key, value);
  const qs = params.toString();
  return qs ? `${prefix}/products?${qs}` : `${prefix}/products`;
}

function isActive(key: string, value: string): boolean {
  return currentFilters[key as keyof typeof currentFilters] === value;
}
---

<div class="bg-white rounded-2xl shadow-sm p-5">
  <h3 class="text-sm font-semibold text-charcoal-800 uppercase tracking-wider mb-5">{t.filter.title}</h3>
  <div class="space-y-4">
    {[
      { key: 'type', label: t.filter.type, options: types, all: t.filter.all },
      { key: 'brand', label: t.filter.brand, options: brands, all: t.filter.all },
      { key: 'installation', label: t.filter.installation, options: installations, all: t.filter.all },
    ].map(group => (
      <div>
        <label class="block text-xs font-medium text-charcoal-500 uppercase mb-2">{group.label}</label>
        <div class="flex flex-wrap gap-1.5">
          <a href={filterUrl(group.key, null)} class={`text-xs px-2.5 py-1 rounded-lg border transition-all ${!currentFilters[group.key as keyof typeof currentFilters] ? 'bg-fire-600 text-white border-fire-600' : 'bg-white text-charcoal-600 border-charcoal-200 hover:border-fire-400'}`}>{group.all}</a>
          {group.options.map(opt => (
            <a href={filterUrl(group.key, opt)} class={`text-xs px-2.5 py-1 rounded-lg border transition-all capitalize ${isActive(group.key, opt) ? 'bg-fire-600 text-white border-fire-600' : 'bg-white text-charcoal-600 border-charcoal-200 hover:border-fire-400'}`}>{opt}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
