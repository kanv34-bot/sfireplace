---
export interface Props {
  brands: string[];
  types: string[];
  installations: string[];
  currentFilters: {
    brand?: string;
    type?: string;
    installation?: string;
    view?: string;
  };
}

const { brands, types, installations, currentFilters } = Astro.props;

// Build URL with filter params
function filterUrl(key: string, value: string | null): string {
  const params = new URLSearchParams();
  const filters = currentFilters;
  
  if (value) {
    params.set(key, value);
  }
  
  // Preserve other filters
  Object.entries(filters).forEach(([k, v]) => {
    if (k !== key && v) {
      params.set(k, v);
    }
  });
  
  const qs = params.toString();
  return qs ? `/products?${qs}` : '/products';
}

function isActive(key: string, value: string): boolean {
  return currentFilters[key as keyof typeof currentFilters] === value;
}

const filterGroups = [
  { key: 'type', label: 'Type', options: types, placeholder: 'All Types' },
  { key: 'brand', label: 'Brand', options: brands, placeholder: 'All Brands' },
  { key: 'installation', label: 'Installation', options: installations, placeholder: 'All Installations' },
];
---

<div class="bg-white rounded-2xl shadow-sm p-5 lg:p-6">
  <h3 class="text-sm font-semibold text-charcoal-800 uppercase tracking-wider mb-5">Filter Products</h3>
  
  <div class="space-y-5">
    {filterGroups.map((group) => (
      <div>
        <label class="block text-xs font-medium text-charcoal-500 uppercase tracking-wider mb-2">{group.label}</label>
        <div class="flex flex-wrap gap-2">
          <a
            href={filterUrl(group.key, null)}
            class={`text-xs px-3 py-1.5 rounded-lg border transition-all ${
              !currentFilters[group.key as keyof typeof currentFilters]
                ? 'bg-fire-600 text-white border-fire-600'
                : 'bg-white text-charcoal-600 border-charcoal-200 hover:border-fire-400 hover:text-fire-600'
            }`}
          >
            {group.placeholder}
          </a>
          {group.options.map((option) => (
            <a
              href={filterUrl(group.key, option)}
              class={`text-xs px-3 py-1.5 rounded-lg border transition-all capitalize ${
                isActive(group.key, option)
                  ? 'bg-fire-600 text-white border-fire-600'
                  : 'bg-white text-charcoal-600 border-charcoal-200 hover:border-fire-400 hover:text-fire-600'
              }`}
            >
              {option}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
