---
export interface Props {
  title: string;
  slug: string;
  image?: string;
  brand?: string;
  type?: string;
  description?: string;
  featured?: boolean;
}

const { title, slug, image, brand, description, featured } = Astro.props;
---

<a
  href={`/products/${slug}`}
  class={`group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 ${featured ? 'ring-2 ring-fire-500/20' : ''}`}
>
  <!-- Image -->
  <div class="aspect-[4/3] bg-charcoal-100 overflow-hidden relative">
    {image ? (
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-charcoal-300">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    {featured && (
      <span class="absolute top-3 right-3 bg-fire-500 text-white text-xs font-bold px-3 py-1 rounded-full">
        Featured
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
      {brand && (
        <span class="text-xs font-medium text-fire-600 bg-fire-50 px-2 py-0.5 rounded">
          {brand}
        </span>
      )}
    </div>
    <h3 class="text-lg font-semibold text-charcoal-800 group-hover:text-fire-600 transition-colors mb-2">
      {title}
    </h3>
    {description && (
      <p class="text-sm text-charcoal-500 line-clamp-2">{description}</p>
    )}
    <span class="inline-flex items-center gap-1 text-sm font-medium text-fire-600 mt-3 group-hover:gap-2 transition-all">
      Learn More
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
