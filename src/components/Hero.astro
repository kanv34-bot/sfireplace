---
export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
  backgroundImage?: string;
  locale?: string;
}

const { title, subtitle, ctaText, ctaLink, secondaryText, secondaryLink, locale = 'en' } = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<section class="relative min-h-[90vh] flex items-center bg-[#f5f5f7] overflow-hidden">
  <!-- Large ambient fire glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-radial from-[#f97316]/10 via-[#f97316]/5 to-transparent rounded-full blur-[100px]"></div>

  <div class="relative w-full max-w-[1200px] mx-auto px-6 lg:px-10 py-24 lg:py-32">
    <div class="max-w-[800px] mx-auto text-center">
      <h1 class="text-[3.5rem] leading-[1.05] lg:text-[4.5rem] lg:leading-[1.05] font-bold tracking-[-0.03em] text-[#1d1d1f] mb-6">
        {title}
      </h1>
      <p class="text-xl lg:text-2xl text-[#86868b] leading-relaxed max-w-[650px] mx-auto mb-10">
        {subtitle}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {ctaText && ctaLink && (
          <a href={`${prefix}${ctaLink}`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-base font-medium transition-all duration-300 bg-[#1d1d1f] text-white hover:bg-black">
            {ctaText}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        )}
        {secondaryText && secondaryLink && (
          <a href={`${prefix}${secondaryLink}`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-base font-medium transition-all duration-300 bg-[#f5f5f7] text-[#1d1d1f] hover:bg-[#e8e8ed]">{secondaryText}</a>
        )}
      </div>
    </div>

    <!-- Stats row - Apple-style centered -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-20 lg:mt-28 max-w-[800px] mx-auto">
      {[
        { value: '15+', label: 'Years<br/>Experience' },
        { value: '200+', label: 'Projects<br/>Completed' },
        { value: '50+', label: 'Premium<br/>Brands' },
        { value: '98%', label: 'Client<br/>Satisfaction' },
      ].map(s => (
        <div class="text-center">
          <div class="text-[2.5rem] lg:text-[3.5rem] font-bold tracking-tight text-[#1d1d1f]">{s.value}</div>
          <div class="text-sm text-[#86868b] mt-1 leading-snug" set:html={s.label}></div>
        </div>
      ))}
    </div>
  </div>
</section>
