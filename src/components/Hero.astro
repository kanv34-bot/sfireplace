---
export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
  backgroundImage?: string;
}

const { title, subtitle, ctaText, ctaLink, secondaryText, secondaryLink } = Astro.props;
---

<section class="relative min-h-[85vh] flex items-center bg-gradient-to-br from-charcoal-900 via-charcoal-800 to-charcoal-900 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(251, 146, 60, 0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>

  <!-- Glow Effect -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-fire-600/15 rounded-full blur-[120px]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32 w-full">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 mb-6">
        <span class="w-2 h-2 bg-fire-500 rounded-full animate-pulse"></span>
        <span class="text-fire-300 text-sm font-medium">Premium Fireplace Supplier</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white leading-tight mb-6">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-charcoal-300 leading-relaxed mb-10 max-w-2xl">
        {subtitle}
      </p>

      <div class="flex flex-wrap gap-4">
        {ctaText && ctaLink && (
          <a
            href={ctaLink}
            class="inline-flex items-center gap-2 bg-fire-600 text-white px-8 py-3.5 rounded-xl text-lg font-semibold hover:bg-fire-700 transition-all shadow-lg shadow-fire-600/25 hover:shadow-fire-600/40"
          >
            {ctaText}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        )}
        {secondaryText && secondaryLink && (
          <a
            href={secondaryLink}
            class="inline-flex items-center gap-2 border-2 border-charcoal-500 text-charcoal-200 px-8 py-3.5 rounded-xl text-lg font-semibold hover:border-fire-500 hover:text-fire-400 transition-all"
          >
            {secondaryText}
          </a>
        )}
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 lg:mt-24 pt-12 lg:pt-16 border-t border-white/10">
      {[
        { number: '15+', label: 'Years Experience' },
        { number: '200+', label: 'Projects Completed' },
        { number: '50+', label: 'Premium Brands' },
        { number: '98%', label: 'Client Satisfaction' },
      ].map((stat) => (
        <div>
          <div class="text-3xl lg:text-4xl font-bold text-fire-400">{stat.number}</div>
          <div class="text-sm text-charcoal-400 mt-1">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
