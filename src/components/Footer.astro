---
const { locale = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();
const loc = locale as string;

const p = (path: string) => loc === 'en' ? path : `/${loc}${path}`;

const footerLinks = [
  { label: p('/products'), text: { en:'Products', zh:'产品', fr:'Produits', es:'Productos', de:'Produkte', it:'Prodotti', ru:'Продукты', ar:'المنتجات' } },
  { label: p('/projects'), text: { en:'Projects', zh:'案例', fr:'Projets', es:'Proyectos', de:'Projekte', it:'Progetti', ru:'Проекты', ar:'المشاريع' } },
  { label: p('/about'), text: { en:'About', zh:'关于', fr:'À propos', es:'Nosotros', de:'Über uns', it:'Chi siamo', ru:'О нас', ar:'من نحن' } },
  { label: p('/contact'), text: { en:'Contact', zh:'联系', fr:'Contact', es:'Contacto', de:'Kontakt', it:'Contatti', ru:'Контакты', ar:'اتصل بنا' } },
];

const getT = (obj: any) => obj[loc] || obj.en;
---

<footer class="bg-[#fafafa] border-t border-[#f0f0f0]">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-10 py-16">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="text-center lg:text-left">
        <a href={loc === 'en' ? '/' : `/${loc}/`} class="flex items-center justify-center lg:justify-start gap-2 mb-2">
          <span class="text-2xl">🔥</span>
          <span class="text-lg font-semibold tracking-tight text-[#1d1d1f]">Fireplace Master</span>
        </a>
        <p class="text-sm text-[#86868b] max-w-sm mt-1">
          {getT({ en:'Premium fireplaces. Timeless warmth.', zh:'高端壁炉，永恒温暖。', fr:'Cheminées premium. Chaleur intemporelle.', es:'Chimeneas premium. Calor atemporal.', de:'Premium-Kamine. Zeitlose Wärme.', it:'Caminetti premium. Calore senza tempo.', ru:'Премиальные камины. Вечное тепло.', ar:'مواقد ممتازة. دفء خالد.' })}
        </p>
      </div>
      <div class="flex items-center gap-6">
        {footerLinks.map(link => (
          <a href={link.label} class="text-sm text-[#86868b] hover:text-[#1d1d1f] transition-colors">{getT(link.text)}</a>
        ))}
      </div>
    </div>
    <div class="border-t border-[#f0f0f0] mt-10 pt-6 text-center text-sm text-[#86868b]">
      &copy; {currentYear} Fireplace Master. {getT({ en:'All rights reserved.', zh:'保留所有权利。', fr:'Tous droits réservés.', es:'Todos los derechos reservados.', de:'Alle Rechte vorbehalten.', it:'Tutti i diritti riservati.', ru:'Все права защищены.', ar:'جميع الحقوق محفوظة.' })}
    </div>
  </div>
</footer>
