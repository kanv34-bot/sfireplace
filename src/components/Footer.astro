---
import { getTranslations, isRtl } from '../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

const { locale } = Astro.props;
const t = getTranslations(locale || 'en');
const rtl = isRtl(locale || 'en');
const currentYear = new Date().getFullYear();

const footerLinks = (loc: string) => [
  { title: t.footer.products, links: [
    { label: { en:'Wood-Burning', zh:'燃木壁炉', fr:'Bois', es:'Leña', de:'Holz', it:'Legna', ru:'Дровяные', ar:'الحطب' }, key: 'wood-burning' },
    { label: { en:'Gas', zh:'燃气壁炉', fr:'Gaz', es:'Gas', de:'Gas', it:'Gas', ru:'Газовые', ar:'الغاز' }, key: 'gas' },
  ]},
  { title: t.footer.company, links: [
    { label: { en:'About Us', zh:'关于我们', fr:'À propos', es:'Nosotros', de:'Über uns', it:'Chi siamo', ru:'О нас', ar:'من نحن' }, key: 'about' },
    { label: { en:'Contact', zh:'联系我们', fr:'Contact', es:'Contacto', de:'Kontakt', it:'Contatti', ru:'Контакты', ar:'اتصل بنا' }, key: 'contact' },
  ]},
];

const p = (path: string) => (locale === 'en' || locale === undefined) ? path : `/${locale}${path}`;
const getLabel = (obj: any) => obj[locale] || obj.en;
---

<footer class="bg-charcoal-900 text-charcoal-300" dir={rtl ? 'rtl' : 'ltr'}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-1">
        <a href={p('/')} class="flex items-center gap-2 mb-4">
          <span class="text-2xl">🔥</span>
          <span class="text-xl font-bold text-white">Fireplace Master</span>
        </a>
        <p class="text-sm leading-relaxed mb-4">{t.footer.description}</p>
      </div>
      {footerLinks(locale).map(col => (
        <div>
          <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">{col.title}</h3>
          <ul class="space-y-2">
            {col.links.map(link => (
              <li><a href={p(`/${link.key === 'about' || link.key === 'contact' ? link.key : 'products?type=' + link.key}`)} class="text-sm hover:text-white transition-colors">{getLabel(link.label)}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="border-t border-charcoal-800 mt-8 pt-6 text-sm text-center">
      <p>&copy; {currentYear} Fireplace Master. {t.footer.rights}</p>
    </div>
  </div>
</footer>
