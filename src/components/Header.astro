---
import { localeLabels, localeShortLabels, isRtl } from '../i18n';

const { locale = 'en' } = Astro.props;
const loc = locale as string;

const navItems = [
  { key: 'home', label: { en:'Home', zh:'首页', fr:'Accueil', es:'Inicio', de:'Start', it:'Home', ru:'Главная', ar:'الرئيسية' } },
  { key: 'products', label: { en:'Products', zh:'产品中心', fr:'Produits', es:'Productos', de:'Produkte', it:'Prodotti', ru:'Продукты', ar:'المنتجات' } },
  { key: 'projects', label: { en:'Projects', zh:'经典案例', fr:'Projets', es:'Proyectos', de:'Projekte', it:'Progetti', ru:'Проекты', ar:'المشاريع' } },
  { key: 'about', label: { en:'About', zh:'关于我们', fr:'À propos', es:'Nosotros', de:'Über uns', it:'Chi siamo', ru:'О нас', ar:'من نحن' } },
  { key: 'blog', label: { en:'Blog', zh:'新闻资讯', fr:'Blog', es:'Blog', de:'Blog', it:'Blog', ru:'Блог', ar:'المدونة' } },
  { key: 'contact', label: { en:'Contact', zh:'联系我们', fr:'Contact', es:'Contacto', de:'Kontakt', it:'Contatti', ru:'Контакты', ar:'اتصل بنا' } },
];

const ctaLabel = { en:'Get a Quote', zh:'获取报价', fr:'Devis', es:'Presupuesto', de:'Angebot', it:'Preventivo', ru:'Заказать', ar:'طلب عرض سعر' };

const allLocales = ['en', 'zh', 'fr', 'es', 'de', 'it', 'ru', 'ar'];
const currentPath = Astro.url.pathname.replace(/^\/[a-z]{2}(\/|$)/, '/');
const getLocalePath = (l: string) => l === 'en' ? currentPath || '/' : `/${l}${currentPath}`;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-charcoal-100 shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href={loc === 'en' ? '/' : `/${loc}/`} class="flex items-center gap-2 group">
        <span class="text-2xl">🔥</span>
        <span class="text-xl font-bold text-charcoal-800 group-hover:text-fire-600 transition-colors">Fireplace Master</span>
      </a>

      <div class="hidden lg:flex items-center gap-6">
        {navItems.map((item) => (
          <a href={loc === 'en' ? `/${item.key}` : `/${loc}/${item.key}`} class="text-sm font-medium text-charcoal-600 hover:text-fire-600 transition-colors">
            {item.label[loc] || item.label.en}
          </a>
        ))}

        <!-- Language Switcher Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 text-xs font-medium text-charcoal-500 hover:text-fire-600 transition-colors px-2.5 py-1.5 rounded-lg border border-charcoal-200 hover:border-fire-400 cursor-pointer">
            <span>{localeShortLabels[loc] || 'EN'}</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute right-0 top-full mt-1 bg-white rounded-xl shadow-lg border border-charcoal-100 py-1.5 min-w-[160px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            {allLocales.map((l) => (
              <a href={getLocalePath(l)} class={`block px-4 py-2 text-sm hover:bg-stone-50 transition-colors ${l === loc ? 'text-fire-600 font-semibold' : 'text-charcoal-600'}`}>
                {localeLabels[l]}
              </a>
            ))}
          </div>
        </div>

        <a href={loc === 'en' ? '/contact' : `/${loc}/contact`} class="bg-fire-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-fire-700 transition-colors shadow-sm">
          {ctaLabel[loc] || ctaLabel.en}
        </a>
      </div>

      <button id="menu-toggle" class="lg:hidden p-2 rounded-lg hover:bg-charcoal-100 transition-colors" aria-label="Toggle menu">
        <svg class="w-6 h-6 text-charcoal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="lg:hidden hidden pb-4 border-t border-charcoal-100 pt-4">
      <div class="flex flex-col gap-2">
        {navItems.map((item) => (
          <a href={loc === 'en' ? `/${item.key}` : `/${loc}/${item.key}`} class="text-sm font-medium text-charcoal-600 hover:text-fire-600 px-2 py-1.5 rounded hover:bg-stone-50">
            {item.label[loc] || item.label.en}
          </a>
        ))}
        <div class="border-t border-charcoal-100 pt-2 mt-2">
          <div class="text-xs font-medium text-charcoal-400 px-2 mb-1">Language</div>
          {allLocales.map((l) => (
            <a href={getLocalePath(l)} class={`block px-2 py-1.5 text-sm ${l === loc ? 'text-fire-600 font-semibold' : 'text-charcoal-600'} hover:bg-stone-50 rounded`}>
              {localeLabels[l]}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
