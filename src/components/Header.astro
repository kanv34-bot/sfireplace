---
import { localeLabels, localeShortLabels } from '../i18n';

const { locale = 'en' } = Astro.props;
const loc = locale as string;

const navItems = [
  { key: 'products', label: { en:'Products', zh:'产品', fr:'Produits', es:'Productos', de:'Produkte', it:'Prodotti', ru:'Продукты', ar:'المنتجات' } },
  { key: 'projects', label: { en:'Projects', zh:'案例', fr:'Projets', es:'Proyectos', de:'Projekte', it:'Progetti', ru:'Проекты', ar:'المشاريع' } },
  { key: 'about', label: { en:'About', zh:'关于', fr:'À propos', es:'Nosotros', de:'Über uns', it:'Chi siamo', ru:'О нас', ar:'من نحن' } },
  { key: 'contact', label: { en:'Contact', zh:'联系', fr:'Contact', es:'Contacto', de:'Kontakt', it:'Contatti', ru:'Контакты', ar:'اتصل بنا' } },
];

const allLocales = ['en', 'zh', 'fr', 'es', 'de', 'it', 'ru', 'ar'];
const currentPath = Astro.url.pathname;
// Remove locale prefix if any
const cleanPath = currentPath.replace(/^\/[a-z]{2}(\/|$)/, '/');
const getLocalePath = (l: string) => l === 'en' ? (cleanPath || '/') : `/${l}${cleanPath}`;

const p = (path: string) => loc === 'en' ? path : `/${loc}${path}`;
const getLabel = (obj: any) => obj[loc] || obj.en;
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-[#f0f0f0]">
  <nav class="max-w-[1200px] mx-auto px-6 lg:px-10 h-14 lg:h-16 flex items-center justify-between">
    <a href={loc === 'en' ? '/' : `/${loc}/`} class="flex items-center gap-2">
      <span class="text-lg">🔥</span>
      <span class="text-[17px] font-semibold tracking-tight text-[#1d1d1f]">Fireplace Master</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-8">
      {navItems.map(item => (
        <a href={p(`/${item.key}`)} class="text-[13px] font-medium text-[#86868b] hover:text-[#1d1d1f] tracking-tight transition-colors">
          {getLabel(item.label)}
        </a>
      ))}

      <!-- Language -->
      <div class="relative group">
        <button class="flex items-center gap-1 text-[13px] font-medium text-[#86868b] cursor-pointer">
          {localeShortLabels[loc]}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="absolute right-0 top-full mt-1.5 bg-white rounded-xl shadow-lg border border-[#f0f0f0] py-1.5 min-w-[170px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          {allLocales.map(l => (
            <a href={getLocalePath(l)} class={`block px-4 py-2 text-sm ${l === loc ? 'text-[#c2410c] font-semibold' : 'text-[#86868b] hover:text-[#1d1d1f]'} transition-colors`}>
              {localeLabels[l]}
            </a>
          ))}
        </div>
      </div>

      <a href={p('/contact')} class="bg-[#1d1d1f] text-white text-[13px] font-medium px-5 py-2 rounded-full hover:bg-black transition-colors">
        {loc === 'en' ? 'Get a Quote' : loc === 'zh' ? '获取报价' : 'Contact'}
      </a>
    </div>

    <!-- Mobile toggle -->
    <button id="menu-toggle" class="lg:hidden p-1.5 rounded-lg hover:bg-gray-100 transition-colors" aria-label="Menu">
      <svg class="w-5 h-5 text-[#1d1d1f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-[#f0f0f0] px-6 pb-5 pt-3 bg-white">
    <div class="flex flex-col gap-1">
      {navItems.map(item => (
        <a href={p(`/${item.key}`)} class="text-sm text-[#86868b] hover:text-[#1d1d1f] py-2 transition-colors">{getLabel(item.label)}</a>
      ))}
      <div class="border-t border-[#f0f0f0] my-2 pt-3">
        <div class="text-xs text-[#86868b] mb-2 font-medium">Language</div>
        <div class="flex flex-wrap gap-2">
          {allLocales.map(l => (
            <a href={getLocalePath(l)} class={`text-sm px-3 py-1.5 rounded-lg ${l === loc ? 'bg-[#1d1d1f] text-white' : 'bg-[#f5f5f7] text-[#86868b]'} transition-colors`}>
              {localeShortLabels[l]}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
