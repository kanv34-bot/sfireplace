---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
}

const { title, description, image, lang = 'en', dir = 'ltr' } = Astro.props;
const siteUrl = 'https://sfireplace.com';
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={`${title} | Fireplace Master`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + path} />
    <meta property="og:image" content={image || `${siteUrl}/images/og-default.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={siteUrl + path} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} | Fireplace Master</title>
  </head>
  <body class="bg-stone-50 text-charcoal-800 antialiased">
    <Header locale={lang} />
    <main>
      <slot />
    </main>
    <Footer locale={lang} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Fireplace Master",
      "url": siteUrl,
      "description": "Premium fireplace supplier offering wood-burning, gas, alcohol, and electric fireplaces."
    })} />
  </body>
</html>
